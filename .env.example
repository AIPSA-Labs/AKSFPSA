# =============================================================================
# AKSFPSA Environment Variables
# =============================================================================

# PostgreSQL Database Connection String
# e.g., Supabase / Neon / Managed Postgres with SSL
DATABASE_URL="postgres://username:password@hostname:5432/database_name?sslmode=require"

# Cloudflare R2 Storage (S3-Compatible)
# Account endpoint format: https://<account_id>.r2.cloudflarestorage.com
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your_r2_access_key_id>"
R2_SECRET_ACCESS_KEY="<your_r2_secret_access_key>"
R2_BUCKET_NAME="aksfpsa"
# Public URL where bucket objects can be accessed (custom domain or r2.dev)
R2_PUBLIC_URL="https://<your_r2_public_domain_or_r2.dev>"

# Optional Admin Credentials (defaults to admin / admin123 if not set)
VITE_ADMIN_USER="admin"
VITE_ADMIN_PASS="admin123"
