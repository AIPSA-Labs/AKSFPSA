# =============================================================================
# AKSFPSA Environment Variables (Configuration Template)
# =============================================================================

# AIPSA Project Database (PostgreSQL REST API or direct postgres:// URL)
DATABASE_URL="https://db.aipsa.in/api/v1/projects/<project_id>"
PUBLISH_KEY="apsk_<publish_key>"
SERVICE_KEY="apsk_<service_key>"

# Cloudflare R2 Storage (S3-Compatible API)
R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"
R2_ACCESS_KEY_ID="<your_r2_access_key_id>"
R2_SECRET_ACCESS_KEY="<your_r2_secret_access_key>"
R2_BUCKET_NAME="aksfpsa"
R2_PUBLIC_URL="https://store.allkeralaprivateschools.org"

# Admin Credentials
VITE_ADMIN_USER="admin"
VITE_ADMIN_PASS="admin123"
